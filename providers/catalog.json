{
  "providers": [
    {
      "id": "anthropic",
      "display_name": "Anthropic",
      "auth": ["api_key", "oauth"],
      "credential_env": ["ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_API_KEY"],
      "base_url_env": ["ANTHROPIC_BASE_URL"],
      "wires": ["anthropic-messages"],
      "base_url_source": "static",
      "endpoints": [
        { "wire": "anthropic-messages", "base_url": "https://api.anthropic.com" }
      ],
      "models_endpoint": "/v1/models",
      "oauth_origin": { "exact": ["https://api.anthropic.com"] },
      "docs": "https://docs.anthropic.com"
    },
    {
      "id": "openai",
      "display_name": "OpenAI",
      "auth": ["api_key"],
      "credential_env": ["OPENAI_API_KEY"],
      "base_url_env": ["OPENAI_BASE_URL"],
      "wires": ["openai-completions", "openai-responses"],
      "base_url_source": "static",
      "endpoints": [
        { "wire": "openai-completions", "base_url": "https://api.openai.com" },
        { "wire": "openai-responses", "base_url": "https://api.openai.com" }
      ],
      "models_endpoint": "/v1/models",
      "docs": "https://platform.openai.com/docs"
    },
    {
      "id": "openai-codex",
      "display_name": "OpenAI Codex",
      "auth": ["oauth"],
      "wires": ["openai-codex-responses"],
      "base_url_source": "static",
      "endpoints": [
        { "wire": "openai-codex-responses", "base_url": "https://chatgpt.com/backend-api/codex" }
      ],
      "oauth_origin": { "exact": ["https://chatgpt.com/backend-api/codex"] },
      "docs": "https://platform.openai.com/docs/codex"
    },
    {
      "id": "github-copilot",
      "display_name": "GitHub Copilot",
      "auth": ["oauth"],
      "wires": ["openai-completions"],
      "base_url_source": "credential",
      "oauth_origin": { "domain": "githubcopilot.com", "credential_declares_origin": true },
      "docs": "https://docs.github.com/copilot"
    },
    {
      "id": "google",
      "display_name": "Google Generative AI",
      "auth": ["api_key"],
      "credential_env": ["GOOGLE_API_KEY"],
      "base_url_env": ["GOOGLE_BASE_URL"],
      "wires": ["google-generative-ai"],
      "base_url_source": "static",
      "endpoints": [
        { "wire": "google-generative-ai", "base_url": "https://generativelanguage.googleapis.com" }
      ],
      "docs": "https://ai.google.dev/api"
    },
    {
      "id": "google-gemini-cli",
      "display_name": "Google Gemini CLI",
      "wires": ["google-gemini-cli"],
      "alias_of": "google",
      "docs": "https://github.com/google-gemini/gemini-cli"
    },
    {
      "id": "azure",
      "display_name": "Azure OpenAI",
      "auth": ["api_key"],
      "credential_env": ["AZURE_OPENAI_API_KEY"],
      "base_url_env": ["AZURE_OPENAI_BASE_URL"],
      "wires": ["openai-responses"],
      "base_url_source": "derived",
      "docs": "https://learn.microsoft.com/azure/ai-services/openai"
    },
    {
      "id": "ollama",
      "display_name": "Ollama",
      "auth": ["none", "api_key"],
      "credential_env": ["OLLAMA_API_KEY"],
      "base_url_env": ["OLLAMA_BASE_URL"],
      "wires": ["ollama"],
      "base_url_source": "local_default",
      "docs": "https://ollama.com/docs/api"
    },
    {
      "id": "kimi",
      "display_name": "Kimi",
      "auth": ["api_key"],
      "credential_env": ["KIMI_API_KEY"],
      "region_env": "KIMI_REGION",
      "wires": ["openai-completions"],
      "base_url_source": "static",
      "endpoints": [
        { "wire": "openai-completions", "base_url": "https://api.kimi.com/coding", "region": "china" },
        { "wire": "openai-completions", "base_url": "https://api.moonshot.ai", "region": "global" }
      ],
      "models_endpoint": "/v1/models",
      "docs": "https://www.kimi.com/code/docs"
    },
    {
      "id": "deepseek",
      "display_name": "DeepSeek",
      "auth": ["api_key"],
      "credential_env": ["DEEPSEEK_API_KEY"],
      "base_url_env": ["DEEPSEEK_BASE_URL"],
      "wires": ["openai-completions"],
      "base_url_source": "static",
      "endpoints": [
        { "wire": "openai-completions", "base_url": "https://api.deepseek.com" }
      ],
      "models_endpoint": "/v1/models",
      "docs": "https://api-docs.deepseek.com"
    }
  ]
}
