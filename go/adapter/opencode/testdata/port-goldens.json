        "Authorization": "Basic b3BlbmNvZGU6c2VjcmV0"
      }
    },
    {
      "name": "history",
      "method": "GET",
      "target": "/base/api/session/ses_fake00000000000000/history?after=3\u0026limit=100",
      "headers": {
        "Accept": "application/json",
        "Authorization": "Basic b3BlbmNvZGU6c2VjcmV0"
      }
    },
    {
      "name": "subscribe",
      "method": "GET",
      "target": "/base/api/session/ses_fake00000000000000/event",
      "headers": {
        "Accept": "text/event-stream",
        "Authorization": "Basic b3BlbmNvZGU6c2VjcmV0"
      }
    },
    {
      "name": "subscribe-after",
      "method": "GET",
      "target": "/base/api/session/ses_fake00000000000000/event?after=5",
      "headers": {
        "Accept": "text/event-stream",
        "Authorization": "Basic b3BlbmNvZGU6c2VjcmV0"
      }
    }
  ]
}
