{
  "name": "oap-sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for the Open Agent Protocol project's runtime, over its stdio protocol",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build:sdk": "tsc -p tsconfig.json",
    "check:declarations": "node scripts/check-npm-declarations.mjs",
    "check:readme": "node scripts/check-readme-samples.mjs",
    "test:sdk": "npm run build:sdk && node --test dist/test/**/*.test.js",
    "demo:start": "npm run build:sdk && node dist/demo/server.js",
    "test": "npm run test:sdk && npm run check:readme"
  },
  "keywords": [
    "oap",
    "open-agent-protocol",
    "sdk",
    "typescript",
    "stdio"
  ],
  "author": "Open Agent Protocol contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsm/open-agent-protocol.git"
  },
  "homepage": "https://github.com/lsm/open-agent-protocol/tree/main/sdk/typescript",
  "license": "ISC",
  "type": "commonjs",
  "files": [
    "dist/src/**/*",
    "README.md"
  ],
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "nanoid": "^5.1.5",
    "ulid": "^3.0.2"
  }
}
