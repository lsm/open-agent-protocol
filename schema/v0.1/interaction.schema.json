{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "interaction.schema.json",
  "title": "Open Agent Protocol user-input payloads",
  "$defs": {
    "option": { "type": "object", "required": ["id", "label"], "properties": { "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "label": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "description": { "type": "string" } }, "additionalProperties": false },
    "question": { "type": "object", "required": ["id", "prompt", "kind"], "properties": { "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "prompt": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "kind": { "enum": ["text", "single_choice", "multi_choice"] }, "required": { "type": "boolean" }, "options": { "type": "array", "items": { "$ref": "#/$defs/option" } } }, "allOf": [{ "if": { "required": ["kind"], "properties": { "kind": { "const": "text" } } }, "then": { "not": { "required": ["options"] } } }, { "if": { "required": ["kind"], "properties": { "kind": { "enum": ["single_choice", "multi_choice"] } } }, "then": { "required": ["options"], "properties": { "options": { "minItems": 1 } } } }], "additionalProperties": false },
    "answer": { "type": "object", "required": ["question_id"], "properties": { "question_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "text": { "type": "string" }, "selected_option_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "oneOf": [{ "required": ["text"], "not": { "required": ["selected_option_ids"] } }, { "required": ["selected_option_ids"], "not": { "required": ["text"] } }], "additionalProperties": false },
    "requested": { "type": "object", "required": ["interaction_id", "requested_by", "responded_by", "session_id", "run_id", "title", "questions"], "properties": { "interaction_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "requested_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "responded_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "tool_call_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "description": { "type": "string" }, "questions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/question" } }, "allow_cancel": { "type": "boolean" }, "draft_answers": { "type": "array", "items": { "$ref": "#/$defs/answer" } } }, "additionalProperties": false },
    "resolveRequest": { "type": "object", "required": ["interaction_id", "requested_by", "responded_by", "session_id", "run_id", "answers"], "properties": { "interaction_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "requested_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "responded_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "answers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/answer" } } }, "additionalProperties": false },
    "resolveResponse": { "type": "object", "required": ["interaction_id", "session_id", "run_id", "accepted"], "properties": { "interaction_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "accepted": { "type": "boolean" } }, "additionalProperties": false },
    "resolved": { "type": "object", "required": ["interaction_id", "requested_by", "responded_by", "session_id", "run_id", "status"], "properties": { "interaction_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "requested_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "responded_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "status": { "enum": ["submitted", "cancelled"] }, "answers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/answer" } } }, "allOf": [{ "if": { "required": ["status"], "properties": { "status": { "const": "submitted" } } }, "then": { "required": ["answers"] } }, { "if": { "required": ["status"], "properties": { "status": { "const": "cancelled" } } }, "then": { "not": { "required": ["answers"] } } }], "additionalProperties": false },
    "cancelRequest": { "type": "object", "required": ["interaction_id", "requested_by", "responded_by", "session_id", "run_id"], "properties": { "interaction_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "requested_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "responded_by": { "$ref": "common.schema.json#/$defs/opaqueID" }, "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "reason": { "type": "string" } }, "additionalProperties": false },
    "cancelResponse": { "$ref": "#/$defs/resolveResponse" }
  }
}
