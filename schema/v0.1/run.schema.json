{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run.schema.json",
  "title": "Open Agent Protocol run payloads",
  "$defs": {
    "status": { "enum": ["queued", "running", "waiting_for_input", "cancelling", "completed", "failed", "cancelled"] },
    "settledBy": { "description": "How the endpoint learned this run reached this terminal. \"observed\" is a run-scoped native terminal the endpoint saw; \"inferred\" is a terminal the endpoint concluded from other evidence, such as a session-scoped stop or transport loss. Absent asserts observation.", "enum": ["observed", "inferred"] },
    "cancelRequest": { "type": "object", "required": ["session_id", "run_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "reason": { "type": "string" } }, "additionalProperties": false },
    "cancelResponse": { "type": "object", "required": ["session_id", "run_id", "accepted", "status"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "accepted": { "type": "boolean" }, "status": { "$ref": "#/$defs/status" } }, "additionalProperties": false },
    "started": { "type": "object", "required": ["session_id", "run_id", "status"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "status": { "const": "running" }, "model_id": { "type": "string" }, "started_at_ms": { "type": "integer" } }, "additionalProperties": false },
    "statusUpdated": { "type": "object", "required": ["session_id", "run_id", "status"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "status": { "$ref": "#/$defs/status" }, "pending_user_input_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "updated_at_ms": { "type": "integer" } }, "additionalProperties": false },
    "contentDelta": { "type": "object", "required": ["session_id", "run_id", "part"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "message_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "part": { "$ref": "common.schema.json#/$defs/contentPart" } }, "additionalProperties": false },
    "completed": { "type": "object", "required": ["session_id", "run_id", "final_response", "stop_reason"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "final_response": { "$ref": "common.schema.json#/$defs/message" }, "stop_reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "model_id": { "type": "string" }, "result": { "type": "object" }, "usage": { "$ref": "common.schema.json#/$defs/usage" }, "duration_ms": { "type": "integer", "minimum": 0 }, "settled_by": { "$ref": "#/$defs/settledBy" } }, "additionalProperties": false },
    "failed": { "type": "object", "required": ["session_id", "run_id", "error"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "error": { "$ref": "common.schema.json#/$defs/protocolError" }, "usage": { "$ref": "common.schema.json#/$defs/usage" }, "duration_ms": { "type": "integer", "minimum": 0 }, "recovery": { "$ref": "common.schema.json#/$defs/recovery" }, "settled_by": { "$ref": "#/$defs/settledBy" } }, "additionalProperties": false },
    "cancelled": { "type": "object", "required": ["session_id", "run_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "reason": { "type": "string" }, "usage": { "$ref": "common.schema.json#/$defs/usage" }, "duration_ms": { "type": "integer", "minimum": 0 }, "settled_by": { "$ref": "#/$defs/settledBy" } }, "additionalProperties": false }
  }
}
