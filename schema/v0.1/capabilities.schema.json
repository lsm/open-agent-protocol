{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "capabilities.schema.json",
  "title": "Open Agent Protocol initialization and capabilities payloads",
  "$defs": {
    "endpoint": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "name": { "type": "string" }, "version": { "type": "string" }, "adapter": { "type": "string" } }, "additionalProperties": false },
    "participant": { "type": "object", "required": ["id"], "properties": { "id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "name": { "type": "string" }, "version": { "type": "string" } }, "additionalProperties": false },
    "featureSupport": { "type": "object", "required": ["level"], "properties": { "level": { "enum": ["native", "emulated", "degraded", "unavailable"] }, "reason": { "type": "string" }, "mode": { "type": "string" }, "modes": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "constraints": { "type": "object", "properties": { "fixed_result": { "type": "object" } } }, "limits": { "type": "object", "properties": { "max_sources": { "type": "integer", "minimum": 1 }, "transports": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } } } }, "additionalProperties": false },
    "toolSourceDescriptor": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "kind": { "enum": ["native", "local", "process", "remote", "hosted"] }, "display_name": { "type": "string" }, "protocol": { "type": "string" }, "endpoint": { "type": "string" } }, "additionalProperties": false },
    "toolDefinition": { "type": "object", "required": ["name", "input_schema", "execution_owner"], "properties": { "name": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "description": { "type": "string" }, "input_schema": { "type": "object" }, "execution_owner": { "$ref": "common.schema.json#/$defs/opaqueID" }, "source": { "$ref": "common.schema.json#/$defs/opaqueID" }, "features": { "type": "object", "additionalProperties": { "$ref": "#/$defs/featureSupport" } }, "annotations": { "type": "object" } }, "additionalProperties": false },
    "binding": { "type": "object", "required": ["kind"], "properties": { "kind": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "serialization": { "type": "string" } }, "additionalProperties": false },
    "degradation": { "type": "object", "required": ["feature", "to", "reason"], "properties": { "feature": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "from": { "enum": ["native", "emulated", "degraded", "unavailable"] }, "to": { "enum": ["native", "emulated", "degraded", "unavailable"] }, "mode": { "type": "string" }, "reason": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "layer": { "type": "object", "properties": { "features": { "type": "object", "additionalProperties": { "$ref": "#/$defs/featureSupport" } }, "requested_delivery_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["auto", "queue", "steer", "btw"] } }, "effective_delivery_modes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["start", "queue", "steer", "btw"] } }, "tools": { "type": "array", "items": { "$ref": "#/$defs/toolDefinition" } }, "sources": { "type": "array", "items": { "$ref": "#/$defs/toolSourceDescriptor" } } }, "additionalProperties": false },
    "initializeRequest": { "type": "object", "required": ["protocol_versions", "profiles"], "properties": { "protocol_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "participant": { "$ref": "#/$defs/participant" } }, "additionalProperties": false },
    "initializeResponse": { "type": "object", "required": ["protocol_version", "profile", "endpoint"], "properties": { "protocol_version": { "const": "0.1" }, "profile": { "const": "open-agent-protocol.agent-control-core" }, "endpoint": { "$ref": "#/$defs/endpoint" } }, "additionalProperties": false },
    "capabilitiesRequest": { "type": "object", "additionalProperties": false },
    "capabilitiesResponse": { "type": "object", "required": ["endpoint"], "properties": { "endpoint": { "$ref": "#/$defs/endpoint" }, "protocol_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "bindings": { "type": "array", "items": { "$ref": "#/$defs/binding" } }, "features": { "type": "object", "additionalProperties": { "$ref": "#/$defs/featureSupport" } }, "layers": { "type": "object", "additionalProperties": { "$ref": "#/$defs/layer" } }, "tools": { "type": "array", "items": { "$ref": "#/$defs/toolDefinition" } }, "sources": { "type": "array", "items": { "$ref": "#/$defs/toolSourceDescriptor" } }, "degradation": { "type": "array", "items": { "$ref": "#/$defs/degradation" } } }, "additionalProperties": false },
    "capabilitiesUpdated": { "type": "object", "required": ["previous_revision"], "properties": { "previous_revision": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "reason": { "type": "string" } }, "additionalProperties": false }
  }
}
