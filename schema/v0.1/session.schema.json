{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.schema.json",
  "title": "Open Agent Protocol session payloads",
  "$defs": {
    "status": { "enum": ["idle", "queued", "running", "waiting_for_input", "closed", "error"] },
    "deliveryRequested": { "enum": ["auto", "queue", "steer", "btw"] },
    "deliveryEffective": { "enum": ["start", "queue", "steer", "btw"] },
    "runPosition": { "type": "object", "required": ["run_id", "sequence"], "properties": { "run_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/opaqueID" }, { "type": "null" }] }, "sequence": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "settledRun": { "type": "object", "required": ["run_id", "sequence"], "properties": { "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "sequence": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "activeRun": {"type": "object", "required": ["run_id", "status", "relationship"], "properties": {"run_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "status": {"$ref": "run.schema.json#/$defs/status"}, "relationship": {"enum": ["primary"]}, "queue_position": {"type": "integer", "minimum": 1}, "as_of_sequence": {"type": "integer", "minimum": 0}, "admitted_submit_requests": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/opaqueID"}}, "pending_interactions": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/opaqueID"}}, "acknowledged_interactions": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/opaqueID"}}, "pending_steers": {"type": "array", "uniqueItems": true, "items": {"type": "object", "required": ["submission_id", "request_id"], "properties": {"submission_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "request_id": {"$ref": "common.schema.json#/$defs/opaqueID"}}, "additionalProperties": false}}}, "additionalProperties": false},
    "sessionCapture": { "type": "object", "properties": { "admitted_submit_requests": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/opaqueID" } }, "settled": { "type": "array", "items": { "$ref": "#/$defs/settledRun" } }, "model_run_sequence": { "$ref": "#/$defs/runPosition" } }, "additionalProperties": false },
    "state": { "type": "object", "required": ["session_id", "status"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "status": { "$ref": "#/$defs/status" }, "active_run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "active_runs": { "type": "array", "items": { "$ref": "#/$defs/activeRun" } }, "current_model_id": { "type": "string" }, "transcript_cursor": { "type": "string" }, "updated_at_ms": { "type": "integer" }, "metadata": { "type": "object" }, "sources": { "type": "array", "items": { "$ref": "capabilities.schema.json#/$defs/toolSourceDescriptor" } }, "recovery": { "$ref": "common.schema.json#/$defs/recovery" }, "as_of": { "$ref": "#/$defs/sessionCapture" }, "reasoning_level": { "$ref": "provider.schema.json#/$defs/reasoningLevel" }, "compaction_policy": { "$ref": "common.schema.json#/$defs/compactionPolicy" } }, "additionalProperties": false },
    "toolSourceAttachment": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "kind": { "$ref": "common.schema.json#/$defs/toolSourceKind" }, "display_name": { "type": "string" }, "protocol": { "type": "string" }, "endpoint": { "type": "string" }, "command": { "type": "string" }, "args": { "type": "array", "items": { "type": "string" } }, "environment": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "openMessage": {"type": "object", "required": ["messages", "delivery"], "properties": {"messages": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/message"}}, "delivery": {"$ref": "#/$defs/deliveryRequested"}, "model_id": {"type": "string"}, "instructions": {"type": "string"}, "tool_choice": true, "output_schema": {"type": "object"}, "allow_degraded_features": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}}, "metadata": {"type": "object"}, "target_run_id": {"$ref": "common.schema.json#/$defs/opaqueID"}}, "additionalProperties": false},
    "openRequest": { "type": "object", "if": { "properties": { "reopen": { "const": true } }, "required": ["reopen"] }, "then": { "required": ["session_id"] }, "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "subscribe": { "type": "boolean" }, "reopen": { "type": "boolean" }, "message": { "$ref": "#/$defs/openMessage" }, "metadata": { "type": "object" }, "tool_sources": { "type": "array", "items": { "$ref": "#/$defs/toolSourceAttachment" } }, "tools": { "type": "array", "items": { "$ref": "capabilities.schema.json#/$defs/toolDefinition" } }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "recovery": { "$ref": "common.schema.json#/$defs/recovery" }, "reasoning_level": { "$ref": "provider.schema.json#/$defs/reasoningLevel" }, "compaction_policy": { "$ref": "common.schema.json#/$defs/compactionPolicy" } }, "additionalProperties": false },
    "openResponse": { "$ref": "#/$defs/state" },
    "stateRequest": { "type": "object", "required": ["session_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" } }, "additionalProperties": false },
    "stateResponse": { "$ref": "#/$defs/state" },
    "stateUpdated": { "$ref": "#/$defs/state" },
    "listRequest": { "type": "object", "properties": { "cursor": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "limit": { "type": "integer", "minimum": 1, "maximum": 100 }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "listEntry": { "type": "object", "required": ["session_id", "adapter", "state", "updated_at_ms"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "adapter": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "harness_version": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "state": { "enum": ["live", "closed"] }, "updated_at_ms": { "type": "integer", "minimum": 0 }, "model": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "directory": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "listResponse": { "type": "object", "required": ["sessions"], "properties": { "sessions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/listEntry" } }, "next_cursor": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "transcriptLoadRequest": { "type": "object", "required": ["session_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "cursor": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "limit": { "type": "integer", "minimum": 1, "maximum": 500 }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "transcriptEntry": { "type": "object", "required": ["entry_id", "kind"], "properties": { "entry_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "kind": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "at_ms": { "type": "integer", "minimum": 0 }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "message": { "$ref": "common.schema.json#/$defs/message" }, "compaction": { "type": "object", "required": ["summary"], "properties": { "compaction_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "summary": { "type": "string" } }, "additionalProperties": false }, "truncated": { "type": "boolean" }, "extensions": { "$ref": "common.schema.json#/$defs/jsonObject" } }, "allOf": [{ "if": { "properties": { "kind": { "const": "message" } } }, "then": { "required": ["message"] } }, { "if": { "properties": { "kind": { "const": "compaction" } } }, "then": { "required": ["compaction"] } }], "additionalProperties": false },
    "transcriptLoadResponse": { "type": "object", "required": ["session_id", "entries", "complete"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "entries": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/transcriptEntry" } }, "next_cursor": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "complete": { "type": "boolean" }, "gap": { "type": "object", "required": ["reason"], "properties": { "reason": { "enum": ["pruned", "rewritten"] }, "resumed_at": { "$ref": "common.schema.json#/$defs/opaqueID" } }, "additionalProperties": false } }, "if": { "properties": { "complete": { "const": false } } }, "then": { "required": ["next_cursor"] }, "additionalProperties": false },
    "modelSwitchRequest": { "type": "object", "required": ["session_id", "model_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "model_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "modelSwitchResponse": { "type": "object", "required": ["session_id", "model_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "model_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "previous_model_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "settingsUpdateRequest": { "type": "object", "required": ["session_id"], "anyOf": [{ "required": ["reasoning_level"] }, { "required": ["compaction_policy"] }], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "reasoning_level": { "$ref": "provider.schema.json#/$defs/reasoningLevel" }, "compaction_policy": { "$ref": "common.schema.json#/$defs/compactionPolicy" }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "settingsUpdateResponse": { "type": "object", "required": ["session_id"], "anyOf": [{ "required": ["reasoning_level"] }, { "required": ["compaction_policy"] }], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "reasoning_level": { "$ref": "provider.schema.json#/$defs/reasoningLevel" }, "compaction_policy": { "$ref": "common.schema.json#/$defs/compactionPolicy" }, "previous_reasoning_level": { "$ref": "provider.schema.json#/$defs/reasoningLevel" }, "previous_compaction_policy": { "$ref": "common.schema.json#/$defs/compactionPolicy" } }, "additionalProperties": false },
    "providerAttachment": { "type": "object", "required": ["id", "provider_id"], "properties": { "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "provider_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "service_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "providerAttachRequest": { "type": "object", "required": ["session_id", "provider"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "provider": { "$ref": "#/$defs/providerAttachment" }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "providerAttachResponse": { "type": "object", "required": ["session_id", "provider_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "provider_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "messageSubmitRequest": {"type": "object", "required": ["session_id", "messages", "delivery"], "properties": {"session_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "messages": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/message"}}, "delivery": {"$ref": "#/$defs/deliveryRequested"}, "model_id": {"type": "string"}, "instructions": {"type": "string"}, "tool_choice": true, "output_schema": {"type": "object"}, "allow_degraded_features": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}}, "metadata": {"type": "object"}, "target_run_id": {"$ref": "common.schema.json#/$defs/opaqueID"}}, "additionalProperties": false},
    "messageSubmitResponse": {"type": "object", "required": ["session_id", "accepted", "submission_id", "requested_delivery", "effective_delivery", "admission"], "properties": {"session_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "accepted": {"type": "boolean"}, "submission_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "requested_delivery": {"$ref": "#/$defs/deliveryRequested"}, "effective_delivery": {"$ref": "#/$defs/deliveryEffective"}, "delivery_resolution": {"type": "string"}, "admission": {"enum": ["started", "queued", "steered", "side_started", "rejected"]}, "run_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "status": {"$ref": "run.schema.json#/$defs/status"}, "model_id": {"type": "string"}, "message_ids": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/opaqueID"}}, "target_sequence": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "compactRequest": {"type": "object", "required": ["session_id"], "properties": {"session_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "delivery": {"$ref": "#/$defs/deliveryRequested"}, "focus": {"type": "string"}, "continue": {"type": "boolean"}, "allow_degraded_features": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/nonEmptyString"}}, "metadata": {"type": "object"}}, "additionalProperties": false},
    "compactResponse": {"type": "object", "required": ["session_id", "accepted", "submission_id", "requested_delivery", "effective_delivery", "admission"], "properties": {"session_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "accepted": {"type": "boolean"}, "submission_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "requested_delivery": {"$ref": "#/$defs/deliveryRequested"}, "effective_delivery": {"$ref": "#/$defs/deliveryEffective"}, "delivery_resolution": {"type": "string"}, "admission": {"enum": ["started", "queued", "steered", "side_started", "rejected"]}, "run_id": {"$ref": "common.schema.json#/$defs/opaqueID"}, "status": {"$ref": "run.schema.json#/$defs/status"}}, "additionalProperties": false}
  }
}
