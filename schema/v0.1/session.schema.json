{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session.schema.json",
  "title": "Open Agent Protocol session payloads",
  "$defs": {
    "status": { "enum": ["idle", "queued", "running", "waiting_for_input", "closed", "error"] },
    "deliveryRequested": { "enum": ["auto", "queue", "steer", "btw"] },
    "deliveryEffective": { "enum": ["start", "queue", "steer", "btw"] },
    "runPosition": { "type": "object", "required": ["run_id", "sequence"], "properties": { "run_id": { "oneOf": [{ "$ref": "common.schema.json#/$defs/opaqueID" }, { "type": "null" }] }, "sequence": { "type": "integer", "minimum": 0 } }, "additionalProperties": false },
    "settledRun": { "type": "object", "required": ["run_id", "sequence"], "properties": { "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "sequence": { "type": "integer", "minimum": 1 } }, "additionalProperties": false },
    "activeRun": { "type": "object", "required": ["run_id", "status", "relationship"], "properties": { "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "status": { "$ref": "run.schema.json#/$defs/status" }, "relationship": { "enum": ["primary"] }, "queue_position": { "type": "integer", "minimum": 1 }, "as_of_sequence": { "type": "integer", "minimum": 0 }, "admitted_submit_requests": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/opaqueID" } }, "pending_interactions": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/opaqueID" } }, "acknowledged_interactions": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/opaqueID" } } }, "additionalProperties": false },
    "sessionCapture": { "type": "object", "properties": { "admitted_submit_requests": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/opaqueID" } }, "settled": { "type": "array", "items": { "$ref": "#/$defs/settledRun" } }, "model_run_sequence": { "$ref": "#/$defs/runPosition" } }, "additionalProperties": false },
    "state": { "type": "object", "required": ["session_id", "status"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "status": { "$ref": "#/$defs/status" }, "active_run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "active_runs": { "type": "array", "items": { "$ref": "#/$defs/activeRun" } }, "current_model_id": { "type": "string" }, "transcript_cursor": { "type": "string" }, "updated_at_ms": { "type": "integer" }, "metadata": { "type": "object" }, "sources": { "type": "array", "items": { "$ref": "capabilities.schema.json#/$defs/toolSourceDescriptor" } }, "recovery": { "$ref": "common.schema.json#/$defs/recovery" }, "as_of": { "$ref": "#/$defs/sessionCapture" } }, "additionalProperties": false },
    "toolSourceAttachment": { "type": "object", "required": ["id", "kind"], "properties": { "id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "kind": { "$ref": "common.schema.json#/$defs/toolSourceKind" }, "display_name": { "type": "string" }, "protocol": { "type": "string" }, "endpoint": { "type": "string" }, "command": { "type": "string" }, "args": { "type": "array", "items": { "type": "string" } }, "environment": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "openMessage": { "type": "object", "required": ["messages", "delivery"], "properties": { "messages": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/message" } }, "delivery": { "$ref": "#/$defs/deliveryRequested" }, "model_id": { "type": "string" }, "instructions": { "type": "string" }, "tool_choice": true, "output_schema": { "type": "object" }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "metadata": { "type": "object" } }, "additionalProperties": false },
    "openRequest": { "type": "object", "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "subscribe": { "type": "boolean" }, "message": { "$ref": "#/$defs/openMessage" }, "metadata": { "type": "object" }, "tool_sources": { "type": "array", "items": { "$ref": "#/$defs/toolSourceAttachment" } }, "tools": { "type": "array", "items": { "$ref": "capabilities.schema.json#/$defs/toolDefinition" } }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "recovery": { "$ref": "common.schema.json#/$defs/recovery" } }, "additionalProperties": false },
    "openResponse": { "$ref": "#/$defs/state" },
    "stateRequest": { "type": "object", "required": ["session_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" } }, "additionalProperties": false },
    "stateResponse": { "$ref": "#/$defs/state" },
    "stateUpdated": { "$ref": "#/$defs/state" },
    "modelSwitchRequest": { "type": "object", "required": ["session_id", "model_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "model_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "modelSwitchResponse": { "type": "object", "required": ["session_id", "model_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "model_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "previous_model_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "providerAttachment": { "type": "object", "required": ["id", "provider_id"], "properties": { "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "provider_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "service_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "providerAttachRequest": { "type": "object", "required": ["session_id", "provider"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "provider": { "$ref": "#/$defs/providerAttachment" }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } } }, "additionalProperties": false },
    "providerAttachResponse": { "type": "object", "required": ["session_id", "provider_id"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "provider_id": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "additionalProperties": false },
    "messageSubmitRequest": { "type": "object", "required": ["session_id", "messages", "delivery"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "messages": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/message" } }, "delivery": { "$ref": "#/$defs/deliveryRequested" }, "model_id": { "type": "string" }, "instructions": { "type": "string" }, "tool_choice": true, "output_schema": { "type": "object" }, "allow_degraded_features": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" } }, "metadata": { "type": "object" } }, "additionalProperties": false },
    "messageSubmitResponse": { "type": "object", "required": ["session_id", "accepted", "submission_id", "requested_delivery", "effective_delivery", "admission"], "properties": { "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "accepted": { "type": "boolean" }, "submission_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "requested_delivery": { "$ref": "#/$defs/deliveryRequested" }, "effective_delivery": { "$ref": "#/$defs/deliveryEffective" }, "delivery_resolution": { "type": "string" }, "admission": { "enum": ["started", "queued", "steered", "side_started", "rejected"] }, "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" }, "status": { "$ref": "run.schema.json#/$defs/status" }, "model_id": { "type": "string" }, "message_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/opaqueID" } } }, "additionalProperties": false }
  }
}
