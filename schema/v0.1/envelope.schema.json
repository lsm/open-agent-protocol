{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "envelope.schema.json",
  "title": "Open Agent Protocol agent-control-core envelope",
  "type": "object",
  "required": ["protocol", "version", "profile", "type", "id", "payload"],
  "properties": {
    "protocol": { "const": "open-agent-protocol" },
    "version": { "const": "0.1" },
    "profile": { "const": "open-agent-protocol.agent-control-core" },
    "type": { "type": "string" },
    "id": { "$ref": "common.schema.json#/$defs/opaqueID" },
    "payload": { "type": "object" },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp_ms": { "type": "integer" },
    "in_reply_to": { "$ref": "common.schema.json#/$defs/opaqueID" },
    "session_id": { "$ref": "common.schema.json#/$defs/opaqueID" },
    "run_id": { "$ref": "common.schema.json#/$defs/opaqueID" },
    "turn_id": { "$ref": "common.schema.json#/$defs/opaqueID" },
    "tool_call_id": { "$ref": "common.schema.json#/$defs/opaqueID" },
    "capability_revision": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "extensions": { "type": "object" }
  },
  "oneOf": [
    { "$ref": "#/$defs/protocolInitializeRequest" },
    { "$ref": "#/$defs/protocolInitializeResponse" },
    { "$ref": "#/$defs/capabilitiesRequest" },
    { "$ref": "#/$defs/capabilitiesResponse" },
    { "$ref": "#/$defs/capabilitiesUpdated" },
    { "$ref": "#/$defs/modelsRequest" },
    { "$ref": "#/$defs/modelsResponse" },
    { "$ref": "#/$defs/authProvidersRequest" },
    { "$ref": "#/$defs/authProvidersResponse" },
    { "$ref": "#/$defs/authLoginStartRequest" },
    { "$ref": "#/$defs/authLoginStartResponse" },
    { "$ref": "#/$defs/authLoginEvent" },
    { "$ref": "#/$defs/authLoginCancelRequest" },
    { "$ref": "#/$defs/authLoginCancelResponse" },
    { "$ref": "#/$defs/authLoginCompleted" },
    { "$ref": "#/$defs/sessionOpenRequest" },
    { "$ref": "#/$defs/sessionOpenResponse" },
    { "$ref": "#/$defs/sessionStateRequest" },
    { "$ref": "#/$defs/sessionStateResponse" },
    { "$ref": "#/$defs/sessionStateUpdated" },
    { "$ref": "#/$defs/sessionModelSwitchRequest" },
    { "$ref": "#/$defs/sessionModelSwitchResponse" },
    { "$ref": "#/$defs/sessionProviderAttachRequest" },
    { "$ref": "#/$defs/sessionProviderAttachResponse" },
    { "$ref": "#/$defs/messageSubmitRequest" },
    { "$ref": "#/$defs/messageSubmitResponse" },
    { "$ref": "#/$defs/runCancelRequest" },
    { "$ref": "#/$defs/runCancelResponse" },
    { "$ref": "#/$defs/runStarted" },
    { "$ref": "#/$defs/runStatusUpdated" },
    { "$ref": "#/$defs/contentDelta" },
    { "$ref": "#/$defs/runCompleted" },
    { "$ref": "#/$defs/runFailed" },
    { "$ref": "#/$defs/runCancelled" },
    { "$ref": "#/$defs/toolsListRequest" },
    { "$ref": "#/$defs/toolsListResponse" },
    { "$ref": "#/$defs/actionCallRequested" },
    { "$ref": "#/$defs/actionCallStarted" },
    { "$ref": "#/$defs/actionCallProgress" },
    { "$ref": "#/$defs/actionCallCompleted" },
    { "$ref": "#/$defs/actionCallFailed" },
    { "$ref": "#/$defs/actionCallCancelled" },
    { "$ref": "#/$defs/actionCallResolveRequest" },
    { "$ref": "#/$defs/actionCallResolveResponse" },
    { "$ref": "#/$defs/permissionRequested" },
    { "$ref": "#/$defs/permissionResolveRequest" },
    { "$ref": "#/$defs/permissionResolveResponse" },
    { "$ref": "#/$defs/permissionResolved" },
    { "$ref": "#/$defs/userInputRequested" },
    { "$ref": "#/$defs/userInputResolveRequest" },
    { "$ref": "#/$defs/userInputResolveResponse" },
    { "$ref": "#/$defs/userInputResolved" },
    { "$ref": "#/$defs/userInputCancelRequest" },
    { "$ref": "#/$defs/userInputCancelResponse" },
    { "$ref": "#/$defs/errorResponse" }
  ],
  "$defs": {
    "response": { "required": ["in_reply_to"] },
    "session": { "required": ["session_id"] },
    "run": { "required": ["session_id", "run_id"] },
    "runEvent": { "required": ["session_id", "run_id", "sequence"] },
    "typed": { "type": "object", "required": ["type", "payload"] },
    "protocolInitializeRequest": { "properties": { "type": { "const": "protocol.initialize.request" }, "payload": { "$ref": "capabilities.schema.json#/$defs/initializeRequest" } } },
    "protocolInitializeResponse": { "allOf": [{ "$ref": "#/$defs/response" }], "properties": { "type": { "const": "protocol.initialize.response" }, "payload": { "$ref": "capabilities.schema.json#/$defs/initializeResponse" } } },
    "capabilitiesRequest": { "properties": { "type": { "const": "capabilities.request" }, "payload": { "$ref": "capabilities.schema.json#/$defs/capabilitiesRequest" } } },
    "capabilitiesResponse": { "allOf": [{ "$ref": "#/$defs/response" }], "required": ["capability_revision"], "properties": { "type": { "const": "capabilities.response" }, "payload": { "$ref": "capabilities.schema.json#/$defs/capabilitiesResponse" } } },
    "capabilitiesUpdated": { "required": ["capability_revision", "sequence"], "properties": { "type": { "const": "capabilities.updated" }, "payload": { "$ref": "capabilities.schema.json#/$defs/capabilitiesUpdated" } } },
    "modelsRequest": { "allOf": [{ "$ref": "#/$defs/session" }], "properties": { "type": { "const": "models.request" }, "payload": { "$ref": "capabilities.schema.json#/$defs/modelsRequest" } } },
    "modelsResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/session" }], "required": ["capability_revision"], "properties": { "type": { "const": "models.response" }, "payload": { "$ref": "capabilities.schema.json#/$defs/modelsResponse" } } },
    "authProvidersRequest": { "properties": { "type": { "const": "auth.providers.request" }, "payload": { "$ref": "auth.schema.json#/$defs/providersRequest" } } },
    "authProvidersResponse": { "allOf": [{ "$ref": "#/$defs/response" }], "properties": { "type": { "const": "auth.providers.response" }, "payload": { "$ref": "auth.schema.json#/$defs/providersResponse" } } },
    "authLoginStartRequest": { "properties": { "type": { "const": "auth.login.start.request" }, "payload": { "$ref": "auth.schema.json#/$defs/loginStartRequest" } } },
    "authLoginStartResponse": { "allOf": [{ "$ref": "#/$defs/response" }], "properties": { "type": { "const": "auth.login.start.response" }, "payload": { "$ref": "auth.schema.json#/$defs/loginStartResponse" } } },
    "authLoginEvent": { "required": ["sequence"], "properties": { "type": { "const": "auth.login.event" }, "payload": { "$ref": "auth.schema.json#/$defs/loginEvent" } } },
    "authLoginCancelRequest": { "properties": { "type": { "const": "auth.login.cancel.request" }, "payload": { "$ref": "auth.schema.json#/$defs/loginCancelRequest" } } },
    "authLoginCancelResponse": { "allOf": [{ "$ref": "#/$defs/response" }], "properties": { "type": { "const": "auth.login.cancel.response" }, "payload": { "$ref": "auth.schema.json#/$defs/loginCancelResponse" } } },
    "authLoginCompleted": { "required": ["sequence"], "properties": { "type": { "const": "auth.login.completed" }, "payload": { "$ref": "auth.schema.json#/$defs/loginCompleted" } } },
    "sessionOpenRequest": { "properties": { "type": { "const": "session.open.request" }, "payload": { "$ref": "session.schema.json#/$defs/openRequest" } } },
    "sessionOpenResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.open.response" }, "payload": { "$ref": "session.schema.json#/$defs/openResponse" } } },
    "sessionStateRequest": { "allOf": [{ "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.state.request" }, "payload": { "$ref": "session.schema.json#/$defs/stateRequest" } } },
    "sessionStateResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.state.response" }, "payload": { "$ref": "session.schema.json#/$defs/stateResponse" } } },
    "sessionStateUpdated": { "allOf": [{ "$ref": "#/$defs/session" }], "required": ["sequence"], "properties": { "type": { "const": "session.state.updated" }, "payload": { "$ref": "session.schema.json#/$defs/stateUpdated" } } },
    "sessionModelSwitchRequest": { "allOf": [{ "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.model.switch.request" }, "payload": { "$ref": "session.schema.json#/$defs/modelSwitchRequest" } } },
    "sessionModelSwitchResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.model.switch.response" }, "payload": { "$ref": "session.schema.json#/$defs/modelSwitchResponse" } } },
    "sessionProviderAttachRequest": { "allOf": [{ "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.provider.attach.request" }, "payload": { "$ref": "session.schema.json#/$defs/providerAttachRequest" } } },
    "sessionProviderAttachResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.provider.attach.response" }, "payload": { "$ref": "session.schema.json#/$defs/providerAttachResponse" } } },
    "messageSubmitRequest": { "allOf": [{ "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.message.submit.request" }, "payload": { "$ref": "session.schema.json#/$defs/messageSubmitRequest" } } },
    "messageSubmitResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/session" }], "properties": { "type": { "const": "session.message.submit.response" }, "payload": { "$ref": "session.schema.json#/$defs/messageSubmitResponse" } } },
    "runCancelRequest": { "allOf": [{ "$ref": "#/$defs/run" }], "properties": { "type": { "const": "run.cancel.request" }, "payload": { "$ref": "run.schema.json#/$defs/cancelRequest" } } },
    "runCancelResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/run" }], "properties": { "type": { "const": "run.cancel.response" }, "payload": { "$ref": "run.schema.json#/$defs/cancelResponse" } } },
    "runStarted": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "run.started" }, "payload": { "$ref": "run.schema.json#/$defs/started" } } },
    "runStatusUpdated": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "run.status.updated" }, "payload": { "$ref": "run.schema.json#/$defs/statusUpdated" } } },
    "contentDelta": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "content.delta" }, "payload": { "$ref": "run.schema.json#/$defs/contentDelta" } } },
    "runCompleted": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "run.completed" }, "payload": { "$ref": "run.schema.json#/$defs/completed" } } },
    "runFailed": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "run.failed" }, "payload": { "$ref": "run.schema.json#/$defs/failed" } } },
    "runCancelled": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "run.cancelled" }, "payload": { "$ref": "run.schema.json#/$defs/cancelled" } } },
    "toolsListRequest": { "properties": { "type": { "const": "action.tools.list.request" }, "payload": { "$ref": "action.schema.json#/$defs/toolsListRequest" } } },
    "toolsListResponse": { "allOf": [{ "$ref": "#/$defs/response" }], "required": ["capability_revision"], "properties": { "type": { "const": "action.tools.list.response" }, "payload": { "$ref": "action.schema.json#/$defs/toolsListResponse" } } },
    "actionCallRequested": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "required": ["tool_call_id"], "properties": { "type": { "const": "action.call.requested" }, "payload": { "$ref": "action.schema.json#/$defs/callRequested" } } },
    "actionCallStarted": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "required": ["tool_call_id"], "properties": { "type": { "const": "action.call.started" }, "payload": { "$ref": "action.schema.json#/$defs/callStarted" } } },
    "actionCallProgress": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "required": ["tool_call_id"], "properties": { "type": { "const": "action.call.progress" }, "payload": { "$ref": "action.schema.json#/$defs/callProgress" } } },
    "actionCallCompleted": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "required": ["tool_call_id"], "properties": { "type": { "const": "action.call.completed" }, "payload": { "$ref": "action.schema.json#/$defs/callCompleted" } } },
    "actionCallFailed": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "required": ["tool_call_id"], "properties": { "type": { "const": "action.call.failed" }, "payload": { "$ref": "action.schema.json#/$defs/callFailed" } } },
    "actionCallCancelled": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "required": ["tool_call_id"], "properties": { "type": { "const": "action.call.cancelled" }, "payload": { "$ref": "action.schema.json#/$defs/callCancelled" } } },
    "actionCallResolveRequest": { "allOf": [{ "$ref": "#/$defs/run" }], "properties": { "type": { "const": "action.call.resolve.request" }, "payload": { "$ref": "action.schema.json#/$defs/callResolveRequest" } } },
    "actionCallResolveResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/run" }], "properties": { "type": { "const": "action.call.resolve.response" }, "payload": { "$ref": "action.schema.json#/$defs/callResolveResponse" } } },
    "permissionRequested": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "required": ["tool_call_id"], "properties": { "type": { "const": "action.permission.requested" }, "payload": { "$ref": "action.schema.json#/$defs/permissionRequested" } } },
    "permissionResolveRequest": { "allOf": [{ "$ref": "#/$defs/run" }], "properties": { "type": { "const": "action.permission.resolve.request" }, "payload": { "$ref": "action.schema.json#/$defs/permissionResolveRequest" } } },
    "permissionResolveResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/run" }], "properties": { "type": { "const": "action.permission.resolve.response" }, "payload": { "$ref": "action.schema.json#/$defs/permissionResolveResponse" } } },
    "permissionResolved": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "action.permission.resolved" }, "payload": { "$ref": "action.schema.json#/$defs/permissionResolved" } } },
    "userInputRequested": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "user.input.requested" }, "payload": { "$ref": "interaction.schema.json#/$defs/requested" } } },
    "userInputResolveRequest": { "allOf": [{ "$ref": "#/$defs/run" }], "properties": { "type": { "const": "user.input.resolve.request" }, "payload": { "$ref": "interaction.schema.json#/$defs/resolveRequest" } } },
    "userInputResolveResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/run" }], "properties": { "type": { "const": "user.input.resolve.response" }, "payload": { "$ref": "interaction.schema.json#/$defs/resolveResponse" } } },
    "userInputResolved": { "allOf": [{ "$ref": "#/$defs/runEvent" }], "properties": { "type": { "const": "user.input.resolved" }, "payload": { "$ref": "interaction.schema.json#/$defs/resolved" } } },
    "userInputCancelRequest": { "allOf": [{ "$ref": "#/$defs/run" }], "properties": { "type": { "const": "user.input.cancel.request" }, "payload": { "$ref": "interaction.schema.json#/$defs/cancelRequest" } } },
    "userInputCancelResponse": { "allOf": [{ "$ref": "#/$defs/response" }, { "$ref": "#/$defs/run" }], "properties": { "type": { "const": "user.input.cancel.response" }, "payload": { "$ref": "interaction.schema.json#/$defs/cancelResponse" } } },
    "errorResponse": { "allOf": [{ "$ref": "#/$defs/response" }], "properties": { "type": { "const": "error.response" }, "payload": { "type": "object", "required": ["error"], "properties": { "error": { "$ref": "common.schema.json#/$defs/protocolError" } }, "additionalProperties": false } } }
  }
}
